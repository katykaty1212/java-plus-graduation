{
  "type": "record",
  "name": "UserActionAvro",
  "namespace": "ru.practicum.ewm.stats.avro",
  "doc": "Действие пользователя с мероприятием",
  "fields": [
    {
      "name": "userId",
      "type": "long",
      "doc": "Идентификатор пользователя"
    },
    {
      "name": "eventId",
      "type": "long",
      "doc": "Идентификатор мероприятия"
    },
    {
      "name": "actionType",
      "type": {
        "type": "enum",
        "name": "ActionTypeAvro",
        "namespace": "ru.practicum.ewm.stats.avro",
        "symbols": ["VIEW", "REGISTER", "LIKE"]
      },
      "doc": "Тип действия"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "Временная метка действия"
    }
  ]
}